{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {},
    "clean": {},
    "dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["@repo/signaling-types#build"]
    }
  },
  "globalEnv": ["METERED_APP_DOMAIN", "METERED_SECRET_KEY"]
}
