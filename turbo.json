{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "deploy": {
      "dependsOn": [
        "lint",
        "@repo/signaling-ws#check-types",
        "@repo/signaling-types#build",
        "@repo/signaling-ws#build",
        "@repo/frontend#build"
      ],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "clean": {},
    "dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["@repo/signaling-types#build"]
    }
  },
  "globalEnv": ["TURSO_DATABASE_URL", "TURSO_AUTH_TOKEN"]
}
