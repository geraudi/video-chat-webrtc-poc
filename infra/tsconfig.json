{
  "compilerOptions": {
    "strict": true,
    "outDir": "bin",
    "target": "es2020",
    // NodeNext (as in @repo/typescript-config/base.json): resolves the
    // `exports` subpath of @repo/signaling-types, and still emits CommonJS
    // because this package is not `"type": "module"` — which is what the
    // Pulumi CLI's ts-node runtime loads.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "experimentalDecorators": true,
    "pretty": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.ts", "src/**/*.ts"],
  "exclude": ["node_modules", ".turbo"]
}
